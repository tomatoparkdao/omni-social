# Copy to .env for Docker Compose. Never commit the completed .env.
OMNISOCIAL_SESSION_SECRET=
OMNISOCIAL_ADMIN_PASSWORD_HASH=
# Defaults to 0. Set to 1 only after a platform-specific production review and an
# explicit operator decision; it enables real Web/CLI/Worker submission paths.
OMNISOCIAL_ENABLE_REAL_PUBLISH=0
